# Copy this file to .env and fill in your values.
# All VITE_* vars are exposed to the client bundle at build time.

VITE_LINGO_API_KEY=your_lingo_key_here
VITE_NEWS_API_KEY=your_newsapi_key_here
VITE_GOOGLE_TTS_API_KEY=your_google_tts_key_here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_TRAVELPAYOUTS_TOKEN=your_travelpayouts_token_here